{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "staq",
  "version": "0.1.0",
  "identifier": "staq",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "staq",
        "width": 400,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "licenseFile": "../LICENSE",
    "resources": {
      "../LICENSE": "LICENSE"
    },
    "icon": [
      "icons/queue/32x32.png",
      "icons/queue/128x128.png",
      "icons/queue/128x128@2x.png",
      "icons/queue/icon.icns",
      "icons/queue/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDYyRkIxODQyMkYyMUYzMTIKUldRUzh5RXZRaGo3WW1NdzUwcGlUejVYUzdGS3B6Z3ZkeXlLcFZkUVBOMm1UWmlMY2lTZnIyMEYK",
      "endpoints": [
        "https://github.com/VVMaestro/staq/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
